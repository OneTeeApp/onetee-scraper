# /etc/onetee/scraper.env — copy, fill in, chmod 640, chown root:scraper.
# Loaded by the runner services' .env (phase 1) and by systemd EnvironmentFile=
# for the sweeper services (phase 2). GitHub Actions secrets override any value
# here for workflow jobs. NEVER commit a filled-in copy.

# Ingest into the API VPS (same value as the VPS_INGEST_TOKEN GitHub secret).
ONETEE_API_URL=https://api.oneteeapp.com
ONETEE_INGEST_TOKEN=

# Webshare ROTATING datacenter endpoint (new exit per request). Same value as
# the TEEITUP_DC_PROXY GitHub secret. Adapters that take a proxy read this name;
# Chromium launches get it via launch(proxy=), not via HTTPS_PROXY.
TEEITUP_PROXY=

# Shared browser cache — keeps every job from re-downloading Chromium.
PLAYWRIGHT_BROWSERS_PATH=/opt/onetee/pw-browsers
